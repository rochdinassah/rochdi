#!/bin/bash

# author: rochdi nassah

export PATH=/opt/rochdi/bin:$PATH

export HOST_ADDR='rochdi.ddns.net'
export HOST_PORT=7000

# aliases start
alias server='ssh rochdi.ddns.net'
alias open='xdg-open $(pwd)'
alias root='sudo -s'
alias update='npm update'
alias azar='echo "globalThis.jotaiAtomCache.get("/__w/azar-web-client/azar-web-client/src/stores/match/atoms.ts/matchSwipeDisableDurationSecondsAtom").read = e => void 0;"'
alias webauth='cd /opt/webauth'
alias desktop='cd /home/$(who|head -n 1|cut -d " " -f 1)/Desktop'
alias c='clear'
alias cleartmp='sudo rm -rf /tmp/* /tmp/.*'
alias stake='cd /opt/stake'
alias kick='cd /opt/kick'
alias rochdi='cd /opt/rochdi'
alias apk='cd /opt/apk'
alias me='cd /opt/me'
alias opt='cd /opt'
if [ $(pwd) == $(echo ~) ]; then desktop; fi
# aliases end

# functions start
pull() {
  git reset --hard HEAD
  git pull
}

push() {
  commit=$@

  if [ 0 == ${#commit} ]
  then
    commit='sync'
  fi
  
  git add -A
  git commit -m "$commit"
  git push
}

mkdir() {
  /usr/bin/mkdir $1 && cd $1
}

btoa() {
  node -e "console.log(btoa('$1'))"
}

atob() {
  node -e "console.log(atob('$1'))"
}
# functions end
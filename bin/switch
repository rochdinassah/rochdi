#!/usr/bin/env node

// author: rochdi nassah

'use strict';

const rochdi = require('../main');

const mode = String(process.argv[2]);

if ('wifi' !== mode && 'ethernet' !== mode)
  exit('switch <mode> must be either "ethernet" or "wifi", "%s" is given', mode);

function getConnectionUUID(search_obj = {}) {
  return new Promise(resolve => {
    exec('nmcli -t -f UUID,TYPE,NAME c s', (err, stdout, stderr) => {
      if (err)
        exit(err);
      const list = stdout.trim().split(/\n/).map(v => {
        const [uuid, type,name] = v.split(':');
        return {
          uuid,
          type,
          name
        }
      });
      
      const entry = list.find(e => {
        for (const search_key of Object.keys(search_obj)) {
          if (e[search_key] !== search_obj[search_key])
            return false;
        }
        return true;
      });

      resolve(entry && entry.uuid);
    })
  });
}

function getEthernetUUID() {
  return getConnectionUUID({ type: '802-3-ethernet' });
}

function getWifiUUID() {
  return getConnectionUUID({ name: 'Fibre_MarocTelecom-0966-5GHz' });
}

function disconnect(uuid) {
  if (!uuid)
    return Promise.resolve();
  return new Promise(resolve => {
    exec(format('nmcli c d %s', uuid), resolve);
  });
}

function connect(uuid) {
  if (!uuid)
    return Promise.resolve();
  return new Promise(resolve => {
    exec(format('nmcli c u %s', uuid), resolve);
  });
}

return getEthernetUUID().then(ethernet_uuid => {
  return getWifiUUID().then(wifi_uuid => {
    if ('wifi' === mode) {
      disconnect(ethernet_uuid);
      connect(wifi_uuid);
    } else if ('ethernet' === mode) {
      disconnect(wifi_uuid);
      connect(ethernet_uuid);
    }
  });
});